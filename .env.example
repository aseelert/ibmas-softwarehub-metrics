# ==============================================================================
# IBM Software Hub & Cloud Pak for Data Telemetry Dashboard — Environment File
# ==============================================================================
#
# HOW TO USE
# ----------
#   cp .env.example .env
#   # Then edit .env to match your cluster.
#
# The dashboard reads this file automatically at startup — no extra tooling
# needed, the loader is built into app/server.py.
#
# REQUIRED vs. OPTIONAL
# ---------------------
# Variables in REQUIRED blocks must be set for accurate results.
# Variables in OPTIONAL blocks are commented out — uncomment only what you need.
# ==============================================================================


# ------------------------------------------------------------------------------
# REQUIRED — Cluster Namespaces
# ------------------------------------------------------------------------------

# Namespace where the IBM License Service operator is running
PROJECT_LICENSE_SERVICE=ibm-licensing

# Namespace where CPD / Software Hub operand pods are deployed
PROJECT_CPD_INST_OPERANDS=cpd-instance


# ------------------------------------------------------------------------------
# REQUIRED — Entitlement Baselines
# Set these to the quantities on your IBM Passport Advantage order.
# VPC covers standalone CPD cartridges (KnowledgeCatalog, DataStage standalone…)
# RU covers watsonx.data editions (Lakehouse, Integration, Intelligence, Premium)
# ------------------------------------------------------------------------------

IBM_VPC_ENTITLEMENT=128
IBM_RU_ENTITLEMENT=1000


# ------------------------------------------------------------------------------
# OPTIONAL — OpenShift Authentication
#
# The dashboard obtains a bearer token in this priority order:
#   1. OCP_TOKEN (explicit token — fastest, works without oc CLI)
#   2. OCP_USER + OCP_PASSWORD — dashboard calls 'oc login' automatically
#   3. Active 'oc' session — calls 'oc whoami -t'
#
# For air-gapped / CI environments where no oc session exists, set either
# OCP_TOKEN or OCP_USER + OCP_PASSWORD.
# ------------------------------------------------------------------------------

# Option A: direct bearer token (get it with: oc whoami -t)
# OCP_TOKEN=sha256~your-cluster-bearer-token-here

# Option B: username + password (dashboard will call 'oc login' automatically)
# OCP_USER=kubeadmin
# OCP_PASSWORD=your-openshift-password-here

# OpenShift API base URL — used for 'oc login' and displayed in the header
# OCP_URL=https://api.your-cluster.example.com:6443


# ------------------------------------------------------------------------------
# OPTIONAL — IBM watsonx.data Edition
#
# Set the edition that matches your Passport Advantage entitlement.
# This controls how the dashboard labels bundled components (especially
# DataStage and IKC) — bundled components are metered as RU, not VPC.
#
# Editions and what they bundle (on-prem Software Hub):
#
#   WXD_LAKEHOUSE (Standard)
#     • watsonx.data core (Presto, Iceberg, MinIO/COS)
#     • OpenSearch (metadata/audit index)
#     • Common Core Services, Zen
#     Metric: RU  |  DataStage: NOT included  |  IKC: NOT included
#
#   WXD_LAKEHOUSE_PREMIUM
#     • Everything in Standard
#     • Milvus vector DB (governed by L-PCPF-BJV4WW)
#     Metric: RU (higher tier)  |  DataStage: NOT included
#
#   WXD_INTEGRATION
#     • Everything in Standard
#     • DataStage Enterprise (ETL pipelines)        → metered as RU (bundled)
#     • Data Replication (CDC/streaming to lakehouse)→ metered as RU (bundled)
#     • DataBand (pipeline observability)           → metered as RU (bundled)
#     • StreamSets (data collector / transformer)   → metered as RU (bundled)
#     Metric: RU  |  DataStage: BUNDLED as RU, no separate VPC row
#
#   WXD_INTELLIGENCE
#     • Everything in WXD_INTEGRATION
#     • IBM Knowledge Catalog / WKC                 → metered as RU (bundled)
#     • IBM MANTA Automated Data Lineage            → metered as RU (bundled)
#     • Analytics Engine (Apache Spark)             → metered as RU (bundled)
#     • Data Product Hub                            → metered as RU (bundled)
#     • Data Refinery                               → metered as RU (bundled)
#     Metric: RU  |  All components BUNDLED as RU, no separate VPC rows
#
# Uncomment exactly ONE of the following:
# WXD_EDITION=WXD_LAKEHOUSE
# WXD_EDITION=WXD_LAKEHOUSE_PREMIUM
# WXD_EDITION=WXD_INTEGRATION
# WXD_EDITION=WXD_INTELLIGENCE
#
# Leave unset if you have standalone CPD (VPC-based) without a watsonx.data
# bundle, or if the IBM License Service is live and you trust its metricName.
# ------------------------------------------------------------------------------

# WXD_EDITION=WXD_LAKEHOUSE


# ------------------------------------------------------------------------------
# OPTIONAL — Install-Options & Component Hints
# Only needed for offline / simulation mode (no live cluster connection).
# ------------------------------------------------------------------------------

# Comma-separated installed component IDs for offline sizing inference.
# Ignored in live mode — the dashboard discovers CRs directly from OpenShift.
# COMPONENTS=ibm-licensing,scheduler,cpfs,cpd_platform,watsonx_data,wkc

# IBM Knowledge Catalog edition hint for offline mode: standard or premium
# IKC_TYPE=standard

# Path to an install-options YAML for offline sizing inspection.
# Default: config/install-options.watsonx-data-no-gpu.yml
# LOCAL_INSTALL_OPTIONS_FILE=config/install-options.watsonx-data-no-gpu.yml


# ------------------------------------------------------------------------------
# OPTIONAL — Dashboard Display Labels
# ------------------------------------------------------------------------------

# Human-readable version string shown in the dashboard header
# IBM_SOFTWARE_HUB_VERSION=IBM Software Hub / CPD 5.3.x-5.4.x, watsonx 2.3.x-2.4.x
