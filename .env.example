# ==============================================================================
# IBM Software Hub & Cloud Pak for Data Telemetry Dashboard - Environment Variables
# ==============================================================================
# Copy this file to .env and adjust the variables for your OpenShift cluster.
# The dashboard uses standard OpenShift CLI ('oc') authentication or bearer tokens.

# ------------------------------------------------------------------------------
# 1. Cluster Namespaces
# ------------------------------------------------------------------------------
# Namespace where the IBM License Service operator is installed (default: ibm-licensing)
PROJECT_LICENSE_SERVICE=ibm-licensing

# Namespace where Cloud Pak for Data / Software Hub operands are deployed (default: cpd-instance)
PROJECT_CPD_INST_OPERANDS=cpd-instance

# ------------------------------------------------------------------------------
# 2. Authentication & Cluster Endpoints (Optional if 'oc' CLI is already logged in)
# ------------------------------------------------------------------------------
# Direct OpenShift Bearer Token (optional; defaults to 'oc whoami -t')
# OCP_TOKEN=sha256~your-cluster-token-here

# OpenShift API URL displayed in the dashboard header
OCP_URL=https://api.watson.ibmas-zocp-techcluster.org:6443

# ------------------------------------------------------------------------------
# 3. Licensing Entitlement Thresholds
# ------------------------------------------------------------------------------
# Baseline purchased VPC pool against which live peak usage is calculated (default: 128)
IBM_VPC_ENTITLEMENT=128

# Baseline Resource Units pool (default: 1000)
IBM_RU_ENTITLEMENT=1000

# ------------------------------------------------------------------------------
# 4. Storage & Software Hub Configuration
# ------------------------------------------------------------------------------
# Active storage class displayed in telemetry
NFS_STORAGE_CLASS=managed-nfs-storage

# NFS server location or storage endpoint
NFS_SERVER_LOCATION=10.10.0.40

# Installed components list (optional; comma-separated component IDs)
COMPONENTS=ibm-licensing,scheduler,cpfs,cpd_platform,watsonx_data,wkc

# Path to install-options YAML for offline sizing inspection
WATSONX_DATA_INSTALL_OPTIONS=config/install-options.watsonx-data-no-gpu.yml
