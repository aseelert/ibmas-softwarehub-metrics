# ==============================================================================
# IBM Software Hub & Cloud Pak for Data Telemetry Dashboard — Active Config
# ==============================================================================

# ------------------------------------------------------------------------------
# REQUIRED — Cluster Namespaces
# ------------------------------------------------------------------------------
PROJECT_LICENSE_SERVICE=ibm-licensing
PROJECT_CPD_INST_OPERANDS=cpd-instance

# ------------------------------------------------------------------------------
# REQUIRED — Entitlement Baselines (from your IBM Passport Advantage order)
# ------------------------------------------------------------------------------
IBM_VPC_ENTITLEMENT=128
IBM_RU_ENTITLEMENT=1000

# ------------------------------------------------------------------------------
# OPTIONAL — OpenShift Authentication
# Priority: OCP_TOKEN > OCP_USER+OCP_PASSWORD > active oc session
# ------------------------------------------------------------------------------
# OCP_TOKEN=sha256~your-cluster-bearer-token-here
# OCP_USER=kubeadmin
# OCP_PASSWORD=your-openshift-password-here
OCP_URL=https://api.watson.ibmas-zocp-techcluster.org:6443

# ------------------------------------------------------------------------------
# OPTIONAL — watsonx.data Edition (controls RU vs VPC labeling for bundled svcs)
# WXD_LAKEHOUSE | WXD_LAKEHOUSE_PREMIUM | WXD_INTEGRATION | WXD_INTELLIGENCE
# ------------------------------------------------------------------------------
# WXD_EDITION=WXD_LAKEHOUSE

# ------------------------------------------------------------------------------
# OPTIONAL — Offline / Simulation Mode Hints
# ------------------------------------------------------------------------------
#COMPONENTS=ibm-licensing,scheduler,cpfs,cpd_platform,watsonx_data,wkc
#WATSONX_DATA_INSTALL_OPTIONS=config/install-options.watsonx-data-no-gpu.yml
